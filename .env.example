TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: only these Telegram users/private-chat IDs can use the bot.
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321

# true: fetch plans through the Iranian SOCKS tunnel.
# false: send the blackout website link at every CHECK_TIMES slot.
DOMESTIC_SERVER_AVAILABLE=true

# Required only when DOMESTIC_SERVER_AVAILABLE=true.
BASE_URI_PROXY=https://uiapi.saapa.ir
# socks5 resolves DNS locally; use socks5h only when the Iranian VPS has DNS.
BARGHE_MAN_PROXY=socks5://127.0.0.1:1080

# Global automatic-check times shared by every authenticated user.
CHECK_TIMES=09:00,15:00

# Send one reminder this many minutes before each blackout; 0 disables it.
BLACKOUT_REMINDER_MINUTES=15
TIMEZONE=Asia/Tehran
